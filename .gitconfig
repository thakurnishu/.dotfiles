[user]
	email = 90508814+thakurnishu@users.noreply.github.com
	name = thakurnishu
[init]
	defaultBranch = main
[http]
	postBuffer = 524288000
	lowSpeedLimit = 0
	lowSpeedTime = 999999
[core]
	compression = 1

[includeIf "gitdir:/home/mahakal/Desktop/src/github.com/work/"]
    path = ~/.gitconfig-work
[credential "https://github.com"]
	helper = 
	helper = !/home/mahakal/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/mahakal/.local/bin/gh auth git-credential
