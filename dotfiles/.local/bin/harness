#!/usr/bin/env bash
# Pick which agent harness to run in this pane, then become it.
#
# The tab used to be hard-wired to `claude`. It is now labelled `harness`
# because the choice is per-pane: claude here, codex in the next space, both
# on the same branch when you want a second opinion.
#
# WHAT IS OFFERED is discovered, never hard-coded: herdr's own list of agent
# kinds, filtered to what is actually on PATH. Two consequences worth knowing:
#
#   * adding a harness to modules/darwin/packages.nix makes it appear here
#     with no edit to this script, which is the point.
#   * the names are herdr's CANONICAL kinds, so the sidebar keeps detecting
#     agent state (working/idle/blocked) for whichever one you pick.
#
# `exec` on purpose: the harness replaces this script rather than nesting
# under it, so quitting drops you at the pane's shell, where running `harness`
# again picks a different one.
#
# --print offers the same menu but writes the choice to stdout instead of
# becoming it. That is how herdr-harness-switch reuses this menu from a POPUP,
# where exec would replace the popup rather than the harness pane.
# --header retitles it, so the popup can say what the choice will DO -- picking
# from a list headed "replace claude" is the confirmation step.
#
# PATH is prepended for the same reason as the other herdr scripts: a tab
# spawned by herdr does not reliably inherit the interactive login PATH.

set -uo pipefail

export PATH="/run/current-system/sw/bin:${HOME:-}/.nix-profile/bin:$PATH"

print_only=0
header='  harness'
while true; do
    case ${1:-} in
        --print)  print_only=1; shift ;;
        --header) header="  ${2:-}"; shift 2 ;;
        *)        break ;;
    esac
done

# herdr agent start --kind, as of 0.x. Anything not installed is skipped, so
# this list costs nothing to keep long.
KINDS=(claude codex opencode pi gemini cursor amp droid copilot grok kimi kiro
       cline agy omp mastracode devin hermes kilo qodercli maki)

# One-line descriptions for the ones worth labelling; the rest show bare.
describe() {
    case $1 in
        claude)   printf 'Claude Code' ;;
        codex)    printf 'OpenAI Codex' ;;
        opencode) printf 'OpenCode' ;;
        gemini)   printf 'Google Gemini' ;;
        pi)       printf 'Pi' ;;
        *)        printf '' ;;
    esac
}

available=()
for k in "${KINDS[@]}"; do
    command -v "$k" >/dev/null 2>&1 && available+=("$k")
done

if [[ ${#available[@]} -eq 0 ]]; then
    printf '\n  \033[31mharness:\033[0m no agent CLI found on PATH.\n' >&2
    printf '  Add one to modules/darwin/packages.nix and switch.\n\n' >&2
    exit 1
fi

# A menu of one is just a slower way to start it.
if [[ ${#available[@]} -eq 1 ]]; then
    if [[ $print_only == 1 ]]; then
        printf '%s\n' "${available[0]}"
        exit 0
    fi
    exec "${available[0]}" "$@"
fi

choice=''
if command -v gum >/dev/null 2>&1; then
    # DO NOT ADD `2>/dev/null` HERE. gum draws the list on STDERR whenever
    # stdout is captured, so silencing stderr renders an invisible menu.
    items=()
    for k in "${available[@]}"; do
        d=$(describe "$k")
        if [[ -n $d ]]; then
            items+=("$(printf '%-10s %s\t%s' "$k" "$d" "$k")")
        else
            items+=("$(printf '%-10s\t%s' "$k" "$k")")
        fi
    done
    choice=$(printf '%s\n' "${items[@]}" | gum choose \
        --header="$header" \
        --header.foreground='#928374' \
        --label-delimiter=$'\t' \
        --cursor='  ❯ ' --cursor.foreground='#fabd2f' \
        --selected.foreground='#fabd2f' --item.foreground='#ebdbb2' \
        --height=10)
elif command -v fzf >/dev/null 2>&1; then
    choice=$(printf '%s\n' "${available[@]}" | fzf --prompt='harness > ' \
        --layout=reverse --height=100%)
else
    # Last resort: no TUI tool, so a numbered prompt on the builtin read.
    printf '\n' >&2
    for i in "${!available[@]}"; do
        printf '  %d) %s\n' "$((i+1))" "${available[$i]}" >&2
    done
    printf '\n  choose [1-%d]: ' "${#available[@]}" >&2
    read -r n
    [[ $n =~ ^[0-9]+$ ]] && [[ $n -ge 1 && $n -le ${#available[@]} ]] &&
        choice=${available[$((n-1))]}
fi

# Escaping the menu leaves you at the shell rather than starting something you
# did not ask for.
[[ -n ${choice:-} ]] || exit 0

if [[ $print_only == 1 ]]; then
    printf '%s\n' "$choice"
    exit 0
fi

exec "$choice" "$@"
