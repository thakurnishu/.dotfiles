#!/usr/bin/env bash
# Build the tabs for a herdr space. The one place that decides what a space
# looks like, called by BOTH herdr-sessionizer (per repo) and
# herdr-worktreeizer (per branch).
#
# It exists because those two grew the same tab-building loop twice, and it
# drifted: hunk had to be added to each separately, the harness tab landed in
# a different slot in each, and only one of them knew to skip lazygit in a
# non-git directory. Anything about the SHAPE of a space belongs here now.
#
#   herdr-space-layout --workspace ID --cwd PATH [OPTIONS]
#
#     --tab1 TAB_ID     the space's existing root tab; renamed to "terminal"
#     --branch NAME     marks this a WORKTREE space -- see the two rules below
#     --source PATH     the main checkout, named in the agent's opening prompt
#     --kind HARNESS    start this harness instead of leaving the picker, and
#                       name the agent after --branch
#     --context TEXT    appended to the agent's opening prompt -- WHY this
#                       worktree exists, in the caller's words. Without it the
#                       agent knows where it is and nothing about what to do.
#
# Two rules differ between the two kinds of space, and both are deliberate:
#
#   gh-dash    only on a REPO space. A worktree's PRs are the parent repo's
#              PRs, so a second dashboard on the same query is noise.
#   focus      a worktree space lands on HARNESS, because its agent is already
#              running with the branch context typed in and making you go find
#              it defeats the point. A repo space lands on TERMINAL, because
#              its harness tab is only a picker and dropping you there would
#              force a harness choice before you have done anything.

set -uo pipefail

export PATH="/run/current-system/sw/bin:${HOME:-}/.nix-profile/bin:$PATH"

HARNESS="${HERDR_HARNESS_BIN:-$HOME/.local/bin/harness}"

LOG="$HOME/.cache/herdr-space-layout.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; }

ws='' cwd='' tab1='' branch='' source_repo='' kind='' extra=''
while [[ $# -gt 0 ]]; do
    case $1 in
        --workspace) ws=${2:-};          shift 2 ;;
        --cwd)       cwd=${2:-};         shift 2 ;;
        --tab1)      tab1=${2:-};        shift 2 ;;
        --branch)    branch=${2:-};      shift 2 ;;
        --source)    source_repo=${2:-}; shift 2 ;;
        --kind)      kind=${2:-};        shift 2 ;;
        --context)   extra=${2:-};       shift 2 ;;
        *)           shift ;;
    esac
done

[[ -n ${ws:-} && -n ${cwd:-} ]] || { log "FAIL: --workspace and --cwd are required"; exit 1; }

jget() {
    python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for k in sys.argv[1:]:
    if not isinstance(d, dict) or k not in d:
        sys.exit(0)
    d = d[k]
print(d)
' "$@" 2>/dev/null
}

# Returns the new tab's "tab_id pane_id", or nothing.
#
# The TRAILING NEWLINE is load-bearing. `read` returns 1 at EOF-without-
# delimiter even though it has already assigned the variables, and the caller
# below guards with `|| continue` -- so without it every tab was created and
# then skipped before its command ran. lazygit, gh-dash and hunk came up as
# bare shells. The harness tab survived only because it guards with `|| true`.
make_tab() {
    local label=$1 tabj t p
    tabj=$(herdr tab create --workspace "$ws" --cwd "$cwd" \
        --label "$label" --no-focus 2>/dev/null)
    t=$(printf '%s' "$tabj" | jget result tab tab_id)
    p=$(printf '%s' "$tabj" | jget result root_pane pane_id)
    [[ -n ${p:-} ]] || return 1
    printf '%s %s\n' "$t" "$p"
}

is_worktree=0
[[ -n ${branch:-} ]] && is_worktree=1

[[ -n $tab1 ]] && herdr tab rename "$tab1" terminal >/dev/null 2>&1

# --- harness, always, and always at slot 2 --------------------------------
# Created FIRST so it lands next to terminal: tabs append, so creation order
# is tab order.
htab='' hpane='' ctx='' start_out='' start_args=()
read -r htab hpane < <(make_tab harness) || true
if [[ -n ${hpane:-} ]]; then
    if [[ -n ${kind:-} && $is_worktree -eq 1 ]]; then
        # feat/vault-rotation -> vault-rotation, so several worktrees of one
        # repo stay tellable apart in herdr's agent panel.
        agent_name=${branch##*/}

        # The context goes in as the harness's OWN opening prompt, not typed
        # into the pane afterwards. Typing was the first design and it is
        # actively unsafe: a harness meeting a directory for the first time
        # asks whether you trust it, and herdr reports codex as `idle` while
        # that dialog is up (claude reports `blocked`). The sentence went into
        # a yes/no dialog and killed the session -- observed, not theorised.
        # Passing it as an argument means the CLI owns the string, so it
        # cannot land anywhere else, and it stays queued behind a trust prompt.
        #
        # The cost is that it SUBMITS on launch, spending one agent turn where
        # typing spent none. Correctness wins: a lost session beats a spent
        # turn.
        # Where it is, then WHY it is there. --context is last so the task
        # is the freshest thing in the prompt, and omitted cleanly when the
        # caller had nothing to add -- an empty tail would read as a truncated
        # sentence to a model that has to act on it.
        ctx="You are working in the git worktree for branch $branch, checked out at $cwd.${source_repo:+ The main checkout is $source_repo.}${extra:+ $extra}"
        # The SHAPE of the argument differs, which is the trap here: claude
        # and codex take a POSITIONAL prompt, while opencode's positional is a
        # project DIRECTORY and its prompt is a named flag. Passing a sentence
        # positionally to opencode would be wrong in a way that looks right.
        start_args=()
        case $kind in
            claude|codex) start_args=(-- "$ctx") ;;
            opencode)     start_args=(-- --prompt "$ctx") ;;
            *)            log "$kind: no known opening-prompt flag; starting bare" ;;
        esac

        # Generous timeout: three harnesses starting at once contended badly
        # enough for opencode to miss the 30s default, though it needs only
        # ~3s on its own.
        # Capture the failure rather than discarding it. "agent start failed"
        # with no reason cost an hour of guessing at timing and contention
        # when the answer was in the message all along.
        if start_out=$(herdr agent start "$agent_name" --kind "$kind" \
            --pane "$hpane" --timeout 90000 \
            "${start_args[@]+"${start_args[@]}"}" 2>&1); then
            log "agent '$agent_name' ($kind) started in $hpane"
        else
            log "agent start failed for $kind in $hpane: ${start_out:0:300}"
            herdr pane run "$hpane" "$HARNESS" >/dev/null 2>&1
        fi
    else
        # Starting bare is normal -- the interactive path leaves the picker on
        # purpose. But a caller who supplied --context clearly expected an
        # agent, and the picker will throw that text away, so say so. This
        # exact combination went unnoticed for a day because it was
        # indistinguishable from a deliberate bare start.
        if [[ -n ${extra:-} ]]; then
            log "WARNING: --context given but no --kind; the picker discards it"
        fi
        herdr pane run "$hpane" "$HARNESS" >/dev/null 2>&1
    fi
fi

# --- the rest, only where they make sense ---------------------------------
# `tab create` spawns a shell in the pane; `pane run` then types the command
# into it, so the tool owns the pane and quitting it leaves a usable shell
# rather than closing the tab.
#
# A non-git directory is a legitimate space (~/.config/*, a notes dir), where
# lazygit and hunk would just sit there erroring. `rev-parse` rather than a
# `.git` test: it is also true in subdirectories and in worktree checkouts,
# where `.git` is a file or absent entirely.
#
# hunk stays LAST so the tab numbers do not move: terminal, harness, lazygit,
# gh-dash are already muscle memory at prefix+1..4.
specs=()
if git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    specs+=("lazygit:lazygit")
    [[ $is_worktree -eq 0 ]] && specs+=("gh-dash:gh-dash-session")
    specs+=("hunk:hunk diff --watch")
else
    log "not a git repo: $cwd -- harness only"
fi

for spec in "${specs[@]+"${specs[@]}"}"; do
    name=${spec%%:*}
    # First colon, not last: the command may carry flags of its own.
    cmd=${spec#*:}
    read -r _t p < <(make_tab "$name") || continue
    [[ -n ${p:-} ]] && herdr pane run "$p" $cmd >/dev/null 2>&1
done

# --- land somewhere useful -------------------------------------------------
if [[ $is_worktree -eq 1 && -n ${htab:-} ]]; then
    herdr tab focus "$htab" >/dev/null 2>&1
elif [[ -n $tab1 ]]; then
    herdr tab focus "$tab1" >/dev/null 2>&1
fi

log "laid out ws=$ws cwd=$cwd worktree=$is_worktree kind='${kind:-}' context=${extra:+yes} tabs=$((1 + ${#specs[@]}))"
exit 0
