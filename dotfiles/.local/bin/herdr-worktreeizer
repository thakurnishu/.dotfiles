#!/usr/bin/env bash
# Open a git worktree as a herdr space laid out as two tabs: terminal, lazygit.
# Either CREATE a worktree for a new branch, or OPEN one that already exists.
#
# The branch-level sibling of herdr-sessionizer: that one opens a space per
# REPO, this one opens a space per BRANCH of the repo you are already in.
# Bound to prefix+shift+g in dotfiles/herdr/config.toml, replacing herdr's
# built-in new_worktree (which creates the space but cannot lay out tabs).
#
# Usage:
#   herdr-worktreeizer                     interactive: pick create or open
#   herdr-worktreeizer <branch> [base]     create (agent path, no prompts)
#   herdr-worktreeizer --open [branch]     open an existing worktree
#   ... --harness <kind>                   skip the harness prompt
#
# PATH is prepended for the same reason as herdr-sessionizer: a herdr popup
# does not reliably inherit the interactive login PATH.

set -uo pipefail

export PATH="/run/current-system/sw/bin:$HOME/.nix-profile/bin:$PATH"

# Absolute, and overridable so the repo copy can be exercised before a switch.
HARNESS="${HERDR_HARNESS_BIN:-$HOME/.local/bin/harness}"
LAYOUT="${HERDR_LAYOUT_BIN:-$HOME/.local/bin/herdr-space-layout}"

LOG="$HOME/.cache/herdr-worktreeizer.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null; }

die() {
    log "FAIL: $*"
    printf '\n  \033[31mherdr-worktreeizer:\033[0m %s\n' "$*" >&2
    printf '  logged to %s\n' "$LOG" >&2
    printf '  press any key to close...' >&2
    read -rsn1 _ 2>/dev/null || sleep 5
    exit 1
}

for t in herdr git; do
    command -v "$t" >/dev/null 2>&1 || die "$t not found on PATH ($PATH)"
done
[[ ${HERDR_ENV:-} == "1" ]] || die "not running inside herdr"

jget() {
    python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for k in sys.argv[1:]:
    if not isinstance(d, dict) or k not in d:
        sys.exit(0)
    d = d[k]
print(d)
' "$@" 2>/dev/null
}

# --- what are we doing? ---------------------------------------------------
# --open/--create are flags rather than positional words so that a branch
# legitimately named "open" still creates a branch.
mode=""
harness_arg=""
while true; do
    case ${1:-} in
        --open)    mode=open;         shift ;;
        --create)  mode=create;       shift ;;
        # Skips the prompt entirely. This is the path an agent or a test uses.
        --harness) harness_arg=${2:-}; shift 2 ;;
        *)         break ;;
    esac
done

branch=${1:-}
base=${2:-}

# A bare branch argument means the agent path: create, no prompts.
[[ -z $mode && -n $branch ]] && mode=create

# --- which workspace are we acting on? ------------------------------------
# Two callers, two answers:
#
#   * an AGENT in a pane inherits HERDR_WORKSPACE_ID -- use it, because the
#     pane it runs in is not necessarily the focused one.
#   * a POPUP (prefix+shift+g) sets HERDR_ENV but NOT HERDR_WORKSPACE_ID, so
#     fall back to the focused workspace, which is the one you invoked from.
#
# Passing an empty --workspace is not harmless: it made this fail with "not
# inside a git repository" from the popup even in a perfectly good repo.
ws_id=${HERDR_WORKSPACE_ID:-}
if [[ -z $ws_id ]]; then
    ws_id=$(herdr api snapshot 2>/dev/null | jget result snapshot focused_workspace_id)
fi
log "workspace resolved to '${ws_id:-<none>}' (env='${HERDR_WORKSPACE_ID:-}')"

# Address the source by workspace when we have one, else by directory --
# passing an empty --workspace is what broke the popup path.
source_args=()
if [[ -n ${ws_id:-} ]]; then
    source_args=(--workspace "$ws_id")
fi

wt_json=$(herdr worktree list "${source_args[@]+"${source_args[@]}"}" 2>/dev/null)
src=$(printf '%s' "$wt_json" | jget result source repo_root)

# Last resort: ask git directly about the popup's own cwd.
if [[ -z ${src:-} ]]; then
    src=$(git rev-parse --show-toplevel 2>/dev/null)
    log "fell back to git rev-parse: '${src:-<none>}'"
    [[ -n ${src:-} ]] && wt_json=$(herdr worktree list --cwd "$src" 2>/dev/null)
    source_args=(--cwd "$src")
fi
[[ -n ${src:-} ]] || die "this space is not inside a git repository"
[[ ${#source_args[@]} -eq 0 ]] && source_args=(--cwd "$src")
repo=$(basename "$src")

# --- shared helpers -------------------------------------------------------

# gum when it is there, fzf when it is not. Items arrive on stdin as
# "label<TAB>value" and the VALUE is what comes back on stdout.
#   DO NOT ADD 2>/dev/null TO THE gum CALL. gum draws its list on STDERR when
#   stdout is captured, so silencing stderr renders an invisible menu.
pick() {
    local header=$1 height=${2:-12}
    if command -v gum >/dev/null 2>&1; then
        gum choose --header="  $header" \
            --header.foreground='#928374' \
            --label-delimiter=$'\t' \
            --cursor='  ❯ ' --cursor.foreground='#fabd2f' \
            --selected.foreground='#fabd2f' --item.foreground='#ebdbb2' \
            --height="$height"
    else
        fzf --prompt="$header > " --layout=reverse --height=100% \
            --delimiter=$'\t' --with-nth=1 | cut -f2-
    fi
}

# Which harness, TYPED rather than arrowed-to.
#
# A gum menu means reaching for the arrow keys mid-flow, and it cannot be
# scripted or piped -- which also made this the one step of the worktree flow
# that could not be tested without simulating keystrokes. Typing a name works
# from the keyboard, from a pipe, and from `--harness`.
#
# Forgiving on purpose: an empty answer takes the first available harness
# (shown as the default), and a unique prefix is enough -- "cl" is claude.
# An answer that matches nothing leaves the picker in the pane rather than
# guessing.
pick_harness() {
    local avail ans match
    avail=$("$HARNESS" --list 2>/dev/null | cut -f1)
    [[ -n ${avail:-} ]] || return 0

    local first
    first=$(printf '%s\n' "$avail" | head -1)

    local prompt="harness [$(printf '%s' "$avail" | tr '\n' '/' | sed 's:/$::')] "
    if command -v gum >/dev/null 2>&1; then
        # DO NOT ADD 2>/dev/null. gum draws on STDERR when stdout is captured.
        ans=$(gum input --prompt "  $prompt> " --placeholder "$first" \
            --prompt.foreground='#fabd2f')
    else
        printf '  %s(default %s): ' "$prompt" "$first" >&2
        read -r ans
    fi

    # Enter on an empty line means "the usual one".
    [[ -n ${ans:-} ]] || { printf '%s' "$first"; return 0; }

    # Exact first, then unique prefix.
    if printf '%s\n' "$avail" | grep -qx -- "$ans"; then
        printf '%s' "$ans"
        return 0
    fi
    match=$(printf '%s\n' "$avail" | grep -i "^$ans" 2>/dev/null)
    if [[ $(printf '%s\n' "$match" | grep -c .) -eq 1 ]]; then
        printf '%s' "$match"
        return 0
    fi
    log "harness '$ans' matched ${match:+several}${match:-nothing}; leaving the picker"
    return 0
}

# The SHAPE of a space lives in herdr-space-layout, shared with
# herdr-sessionizer so the two can never drift apart again.
layout() {
    local ws=$1 tab1=$2 checkout=$3 branch=$4 kind=${5:-}
    "$LAYOUT" --workspace "$ws" --cwd "$checkout" \
        ${tab1:+--tab1 "$tab1"} \
        --branch "$branch" --source "$src" \
        ${kind:+--kind "$kind"}
}

# --- mode menu ------------------------------------------------------------
if [[ -z $mode ]]; then
    mode=$(printf 'create   new branch + worktree\tcreate\nopen     existing worktree\topen\n' \
        | pick "$repo" 4)
    [[ -n ${mode:-} ]] || exit 0
fi
log "mode=$mode repo=$src"

# ==========================================================================
# OPEN an existing worktree
# ==========================================================================
if [[ $mode == open ]]; then
    # open_workspace_id is only present when this SESSION already has the
    # worktree open -- reopening it would stack a duplicate space, so focus
    # the existing one instead.
    rows=$(printf '%s' "$wt_json" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for w in d.get("result", {}).get("worktrees", []):
    if not w.get("is_linked_worktree"):
        continue
    print("\t".join([
        w.get("branch") or "(detached)",
        w.get("path", ""),
        w.get("open_workspace_id") or "",
    ]))
' 2>/dev/null)

    [[ -n ${rows:-} ]] || die "$repo has no linked worktrees yet -- create one first"

    # The checkout path is the value the picker returns, because it is the one
    # field guaranteed unique -- two worktrees can never share a directory.
    # Everything else is looked up from it, which also keeps exactly ONE tab
    # in each picker line (gum splits label from value on the first one).
    if [[ -n $branch ]]; then
        # Agent path: match on branch name, else on the checkout's basename.
        checkout=$(printf '%s\n' "$rows" | awk -F'\t' -v b="$branch" \
            '$1==b || $2 ~ ("/" b "$") {print $2; exit}')
        [[ -n ${checkout:-} ]] || die "no worktree for '$branch' in $repo"
    else
        # "branch -> dirname [open]" reads better than a wall of long paths.
        checkout=$(printf '%s\n' "$rows" | awk -F'\t' '{
            n = split($2, p, "/"); mark = ($3 == "" ? "" : "  [open]")
            printf "%-38s %s%s\t%s\n", $1, p[n], mark, $2
        }' | pick "open worktree in $repo" 14)
        [[ -n ${checkout:-} ]] || exit 0
    fi

    wt_branch=$(printf '%s\n' "$rows" | awk -F'\t' -v c="$checkout" '$2==c {print $1; exit}')
    open_ws=$(printf '%s\n' "$rows"  | awk -F'\t' -v c="$checkout" '$2==c {print $3; exit}')
    log "open branch=$wt_branch checkout=$checkout already_open='${open_ws:-}'"

    if [[ -n ${open_ws:-} ]]; then
        herdr workspace focus "$open_ws" >/dev/null 2>&1 \
            || die "could not focus the space already showing $wt_branch"
        exit 0
    fi

    label=$(printf '%s' "$wt_branch" | tr '/' '-')
    out=$(herdr worktree open "${source_args[@]}" \
        --path "$checkout" --label "$label" --focus 2>&1)

    ws=$(printf '%s' "$out" | jget result workspace workspace_id)
    tab1=$(printf '%s' "$out" | jget result tab tab_id)
    [[ -n ${ws:-} ]] || die "worktree open failed: $(printf '%s' "$out" | head -c 200)"
    log "opened ws=$ws checkout=$checkout"

    # Only when a human is driving: an agent calling this has stdin on
    # /dev/null, gum has nothing to draw on, and leaving the picker in the pane
    # is the right answer there anyway.
    kind=$harness_arg
    [[ -z $kind && -t 0 ]] && kind=$(pick_harness)
    layout "$ws" "${tab1:-}" "$checkout" "$wt_branch" "${kind:-}"
    exit 0
fi

# ==========================================================================
# CREATE a worktree for a new branch
# ==========================================================================

# --- branch name ---------------------------------------------------------
if [[ -n $branch ]]; then
    :
elif command -v gum >/dev/null 2>&1; then
    branch=$(gum input --prompt 'new branch > ' --placeholder 'feat/my-thing' \
        --prompt.foreground='#fabd2f')
else
    printf '  new branch for %s: ' "$repo" >&2
    read -r branch
fi
[[ -n ${branch:-} ]] || exit 0

# --- base branch ---------------------------------------------------------
bases=$(git -C "$src" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)
current=$(git -C "$src" rev-parse --abbrev-ref HEAD 2>/dev/null)
if [[ -n $base ]]; then
    :
else
    base=$(printf '%s\n' "$bases" | awk '{print $0 "\t" $0}' \
        | pick "base branch for $branch" 12)
fi
# Escaping the base picker falls back to the branch that is checked out now,
# rather than aborting work already half done.
base=${base:-$current}
[[ -n ${base:-} ]] || die "could not determine a base branch"

label=$(printf '%s' "$branch" | tr '/' '-')
log "create branch=$branch base=$base repo=$src"

out=$(herdr worktree create "${source_args[@]}" \
    --branch "$branch" --base "$base" --label "$label" --focus 2>&1)

ws=$(printf '%s' "$out" | jget result workspace workspace_id)
tab1=$(printf '%s' "$out" | jget result tab tab_id)
checkout=$(printf '%s' "$out" | jget result workspace worktree checkout_path)

[[ -n ${ws:-} ]] || die "worktree create failed: $(printf '%s' "$out" | head -c 200)"
log "created ws=$ws checkout=$checkout"

kind=$harness_arg
[[ -z $kind && -t 0 ]] && kind=$(pick_harness)
layout "$ws" "${tab1:-}" "$checkout" "$branch" "${kind:-}"
exit 0
