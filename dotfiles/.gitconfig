[user]
	email = 90508814+thakurnishu@users.noreply.github.com
	name = thakurnishu

[init]
	defaultBranch = main

# Slow-connection tuning, carried over from the Ubuntu config.
[http]
	postBuffer = 524288000
	lowSpeedLimit = 0
	lowSpeedTime = 999999

[core]
	compression = 1

[includeIf "gitdir:~/src/github.com/work/solytics/"]
	path = ~/.gitwork-solytics

[credential "https://github.com"]
	helper =
	helper = !/run/current-system/sw/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/run/current-system/sw/bin/gh auth git-credential
