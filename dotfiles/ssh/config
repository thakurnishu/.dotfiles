# SSH config — the version-controlled half.
#
# This repo is PUBLIC, so only generic entries live here. Hosts that would
# disclose infrastructure (LAN addresses, EC2, employer GitLab, other
# accounts) are in ~/.ssh/config.local, which is untracked.
#
# SSH ignores Include paths that don't exist, so both lines below are safe
# on a fresh machine.

# Machine-local hosts, not version-controlled.
Include ~/.ssh/config.local

# Generated by colima when the Docker VM is running.
Include ~/.colima/ssh_config

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/github_personal

# NOTE: no `Host *` defaults block, by choice. Worth knowing that with more
# than one GitHub key loaded in the agent, ssh offers all of them and GitHub
# accepts the first that authenticates — which can silently be the wrong
# account. `IdentitiesOnly yes` is the fix if that ever bites.
